# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ─────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insurance_os"

# ── Redis / jobs ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ─────────────────────────────────────────────
JWT_SECRET="change-me"
# junior approval authority (premium ceiling); above this → escalate
JUNIOR_PREMIUM_CAP=150000

# ── LLM (Anthropic Claude) ───────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
LLM_MODEL_FAST="claude-haiku-4-5-20251001"   # classification / routine drafting
LLM_MODEL_STANDARD="claude-sonnet-5"          # narratives / most drafting
LLM_MODEL_DEEP="claude-opus-4-8"              # sensitive / hard reasoning

# ── Nango connectors (Gmail / Sheets / Drive) ────────
NANGO_SECRET_KEY="..."
NANGO_HOST="https://api.nango.dev"
NANGO_INTEGRATION_MAIL="google-mail"
NANGO_INTEGRATION_SHEET="google-sheet"
NANGO_INTEGRATION_DRIVE="google-drive"
CONNECTORS_MODE="mock"   # mock = use fixtures offline | live = real Nango

# ── Test data / fixtures ─────────────────────────────
TEST_DATA_ROOT="D:\\INDUSTRY AI OS bac\\test data"
