# ── App ──────────────────────────────────────────────
APP_ENV=development
PORT=4000
DOCUMENT_STORAGE_ROOT="./storage"

# ── Database ─────────────────────────────────────────
# Dev default: SQLite (async via aiosqlite). Models are Postgres-compatible, so to
# switch later just point this at Postgres — no code change:
#   DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/insurance_os"
DATABASE_URL="sqlite+aiosqlite:///./insurance_os.db"

# ── Redis / jobs (Arq) ───────────────────────────────
# Async ingestion→extraction jobs run on Arq/Redis (Phase 1).
# Not required for the test suite (async test uses Arq burst mode).
REDIS_URL="redis://localhost:6379"

# ── Auth ─────────────────────────────────────────────
# Phase 0 auth is a header stub (x-tenant-id / x-user-id / x-role) — no login flow.
# JWT_SECRET="change-me"   # (Phase 1)
# Junior approval authority (premium ceiling); above this → escalate.
JUNIOR_PREMIUM_CAP=150000

# ── LLM (OpenAI) ── (used in Phase 1) ────────────────
OPENAI_API_KEY="sk-..."
LLM_MODEL_FAST="gpt-4o-mini"     # classification / routine drafting
LLM_MODEL_STANDARD="gpt-4o"      # narratives / most drafting
LLM_MODEL_DEEP="gpt-4.1"         # sensitive / hard reasoning

# ── Nango connectors (Gmail / Sheets / Drive) ── (used in Phase 1) ──
NANGO_SECRET_KEY="..."
NANGO_HOST="https://api.nango.dev"
NANGO_INTEGRATION_MAIL="google-mail"
NANGO_INTEGRATION_SHEET="google-sheet"
NANGO_INTEGRATION_DRIVE="google-drive"
NANGO_INBOX_QUERY="in:inbox newer_than:30d subject:submission"
CONNECTORS_MODE="mock"   # mock = use fixtures offline | live = real Nango

# ── Test data / fixtures ─────────────────────────────
TEST_DATA_ROOT="D:\\INDUSTRY AI OS bac\\test data"
