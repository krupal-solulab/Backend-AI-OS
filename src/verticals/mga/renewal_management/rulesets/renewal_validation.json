{
  "category": "mga_renewal_management_validation",
  "rules": [
    {
      "id": "doc.prior_policy.required",
      "label": "Prior policy snapshot present",
      "field": "documents.prior_policy.present",
      "check": "required",
      "severity": "error",
      "message": "Prior policy snapshot missing — cannot compare against expiring term",
      "enabled": true
    },
    {
      "id": "doc.renewal_questionnaire.required",
      "label": "Renewal questionnaire present",
      "field": "documents.renewal_questionnaire.present",
      "check": "required",
      "severity": "error",
      "message": "Renewal questionnaire missing (RN-12) — broker outreach needed",
      "enabled": true
    },
    {
      "id": "doc.loss_run.required",
      "label": "Updated loss run present",
      "field": "documents.loss_run.present",
      "check": "required",
      "severity": "error",
      "message": "Updated loss run missing — cannot assess loss activity",
      "enabled": true
    },
    {
      "id": "prior_policy.named_insured.required",
      "label": "Prior named insured present",
      "field": "prior_policy.named_insured",
      "check": "required",
      "severity": "error",
      "message": "Prior named insured missing",
      "enabled": true
    }
  ]
}
